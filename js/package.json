{
  "name": "@nearata/flarum-ext-copy-code-to-clipboard",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "flarum-tsconfig-v1": "npm:flarum-tsconfig@^1.0.2",
    "flarum-tsconfig-v2": "npm:flarum-tsconfig@^2.0.0",
    "flarum-webpack-config-v1": "npm:flarum-webpack-config@^2.0.0",
    "flarum-webpack-config-v2": "npm:flarum-webpack-config@^3.0.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^4.9.2",
    "typescript": "^4.5.4"
  },
  "scripts": {
    "build": "npm run build:v1 && npm run build:v2",
    "build:v1": "webpack --config webpack.v1.cjs --mode production",
    "build:v2": "webpack --config webpack.v2.cjs --mode production",
    "format": "biome check --write src",
    "test": "biome check src"
  }
}
